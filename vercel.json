{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/product/:slug", "destination": "/api/product-seo?slug=:slug" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/product-seo.js": { "maxDuration": 30 },
    "api/sitemap.js": { "maxDuration": 30 }
  },
  "headers": [
    { "source": "/signin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/admin", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/account", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/cart", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/order", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/my-orders", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/wishlist", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/notifications", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/payment/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] }
  ]
}
